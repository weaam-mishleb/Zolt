{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "zolt-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "zolt-backend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "backend.app.main:app", "--port", "8000"],
      "port": 8000
    }
  ]
}
